# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Production URI
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/dev-studio?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Local MongoDB (Dev Fallback only)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/dev-studio

# Security & Authentication
JWT_SECRET=generate_a_long_random_secret_here

# Allowed Client Origin (Netlify URL in production, or * for all)
CLIENT_URL=https://your-dev-studio-frontend.netlify.app